{
  "expo": {
    "name": "Sharp",
    "slug": "sharp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sharp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.jude.sharp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#146cd1"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#146cd1",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#146cd1"
          }
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Sharp utilise la caméra pour prendre votre photo de profil.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sharp accède à vos photos pour choisir votre photo de profil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
